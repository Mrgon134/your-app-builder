VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_TIKTOK_PIXEL_ID=

# Optional analytics override. Localhost/dev capture stays disabled unless
# VITE_POSTHOG_ENABLE_LOCAL=true, so local previews do not pollute PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENABLE_LOCAL=false

# Required for native iOS purchases. Use the RevenueCat public Apple SDK key,
# usually starting with appl_.
VITE_REVENUECAT_API_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=entlf84d73930a
VITE_REVENUECAT_PLUS_ENTITLEMENT_ID=plus

# Required by Codemagic for App Store Connect upload/build-number automation.
APP_STORE_CONNECT_KEY_IDENTIFIER=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
